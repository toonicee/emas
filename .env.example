# URL kanonik situs. Dipakai metadataBase, canonical, OG image, dan sitemap.
# Tanpa ini, preview link di WhatsApp/X/LinkedIn tidak akan memuat gambar.
NEXT_PUBLIC_SITE_URL=https://suvarna.co.id

# Formulir kontak DDSM → Google Sheet. Cara memasang Apps Script-nya ada di
# kepala berkas scripts/google-apps-script/ddsm-contact.gs.
# Keduanya HANYA dibaca di server (sengaja tanpa awalan NEXT_PUBLIC_), jadi
# tidak pernah terkirim ke browser. Tanpa keduanya, formulir menampilkan pesan
# gagal dan server mencatat peringatan — pesan pengunjung TIDAK tersimpan.
DDSM_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/GANTI_DENGAN_ID_DEPLOYMENT/exec
# String acak panjang, SAMA PERSIS dengan Script property DDSM_SHEETS_SECRET di
# Apps Script. Buat misalnya dengan: openssl rand -hex 32
DDSM_SHEETS_SECRET=
